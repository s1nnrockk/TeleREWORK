# Copy to .env on the server. Never commit the real .env.
PUBLIC_HOST=relay.example.com
ACME_EMAIL=admin@example.com
PUBLIC_BASE_PATH=
MTPROXY_HOST=your-mtproxy.example
MTPROXY_PORT=443
# Hex-encoded decoded MTProxy secret (16–64 bytes; include leading dd if used).
MTPROXY_SECRET_HEX=replace_with_real_hex_secret
SESSION_TTL=900
